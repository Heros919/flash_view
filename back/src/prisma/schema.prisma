generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model admin {
  id          Int           @id @default(autoincrement())
  nome        String        @db.VarChar(100)
  email       String        @unique @db.VarChar(150)
  senha       String        @db.VarChar(255)
  funcionario funcionario[]
}

model bloco {
  id             String      @id @db.VarChar(100)
  cliente_id     Int
  funcionario_id String      @db.VarChar(100)
  codigo         String      @unique @db.VarChar(50)
  numero         Int
  material       String?     @db.VarChar(150)
  cor            String?     @db.VarChar(160)
  altura         Decimal?    @db.Decimal(10, 2)
  largura        Decimal?    @db.Decimal(10, 2)
  comprimento    Decimal?    @db.Decimal(10, 2)
  peso           Decimal?    @db.Decimal(10, 2)
  volume         Decimal?    @default(dbgenerated("((altura * largura) * comprimento)")) @db.Decimal(12, 3)
  mes            Int
  ano            Int
  frente         String      @db.VarChar(50)
  datacadastro   DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Date
  cliente        cliente     @relation(fields: [cliente_id], references: [id], map: "fk_bloco_cliente")
  funcionario    funcionario @relation(fields: [cliente_id, funcionario_id], references: [cliente_id, id], map: "fk_bloco_funcionario")
  chapa          chapa[]
  midia          midia[]

  @@index([ano], map: "idx_bloco_ano")
  @@index([cliente_id], map: "idx_bloco_cliente_id")
  @@index([cor], map: "idx_bloco_cor")
  @@index([frente], map: "idx_bloco_frente")
  @@index([funcionario_id], map: "idx_bloco_funcionario_id")
  @@index([material], map: "idx_bloco_material")
  @@index([mes], map: "idx_bloco_mes")
}

model chapa {
  id             String      @id @db.VarChar(100)
  cliente_id     Int
  funcionario_id String      @db.VarChar(100)
  codigo         String      @unique @db.VarChar(50)
  blocoid        String      @db.VarChar(100)
  espessura      Decimal?    @db.Decimal(10, 2)
  altura         Decimal?    @db.Decimal(10, 2)
  largura        Decimal?    @db.Decimal(10, 2)
  acabamento     String?     @db.VarChar(150)
  status         String      @default("DISPONIVEL") @db.VarChar(20)
  datacadastro   DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Date
  bloco          bloco       @relation(fields: [blocoid], references: [id], map: "fk_chapa_bloco")
  cliente        cliente     @relation(fields: [cliente_id], references: [id], map: "fk_chapa_cliente")
  funcionario    funcionario @relation(fields: [cliente_id, funcionario_id], references: [cliente_id, id], map: "fk_chapa_funcionario")
  midia          midia[]

  @@index([acabamento], map: "idx_chapa_acabamento")
  @@index([blocoid], map: "idx_chapa_blocoid")
  @@index([cliente_id], map: "idx_chapa_cliente_id")
  @@index([funcionario_id], map: "idx_chapa_funcionario_id")
  @@index([status], map: "idx_chapa_status")
}

model cliente {
  id              Int               @id @default(autoincrement())
  nome            String            @db.VarChar(100)
  cpf             String            @unique @db.VarChar(11)
  numero          String            @db.VarChar(20)
  bloco           bloco[]
  chapa           chapa[]
  endereco        endereco[]
  funcionario     funcionario[]
  produto_servico produto_servico[]
  venda           venda[]
}

model endereco {
  id            Int     @id @default(autoincrement())
  cliente_id    Int
  complemento   String? @db.VarChar(100)
  estado        String  @db.Char(2)
  local_entrega String  @db.Char(3)
  cliente       cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade, map: "fk_endereco_cliente")

  @@index([cliente_id], map: "idx_endereco_cliente_id")
}

model funcionario {
  id         String  @id @db.VarChar(100)
  cliente_id Int
  admin_id   Int
  nome       String  @db.VarChar(150)
  email      String  @unique @db.VarChar(255)
  senha      String
  bloco      bloco[]
  chapa      chapa[]
  admin      admin   @relation(fields: [admin_id], references: [id], map: "fk_funcionario_admin")
  cliente    cliente @relation(fields: [cliente_id], references: [id], map: "fk_funcionario_cliente")
  venda      venda[]

  @@unique([cliente_id, id], map: "uq_funcionario_cliente_id")
  @@index([admin_id], map: "idx_funcionario_admin_id")
  @@index([cliente_id], map: "idx_funcionario_cliente_id")
}


model midia {
  id           String   @id @db.VarChar(100)
  nome         String   @db.VarChar(255)
  tipo         String   @db.VarChar(20)
  formato      String   @db.VarChar(100)
  dados        Bytes
  blocoid      String?  @db.VarChar(100)
  chapaid      String?  @db.VarChar(100)
  datacadastro DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  bloco        bloco?   @relation(fields: [blocoid], references: [id], onDelete: Cascade, map: "fk_midia_bloco")
  chapa        chapa?   @relation(fields: [chapaid], references: [id], onDelete: Cascade, map: "fk_midia_chapa")
}


model produto_servico {
  id           Int          @id @default(autoincrement())
  cliente_id   Int
  tipo_id      Int
  nome         String       @db.VarChar(150)
  descricao    String?
  preco        Decimal      @db.Decimal(12, 2)
  ativo        Boolean      @default(true)
  datacadastro DateTime     @default(dbgenerated("CURRENT_DATE")) @db.Date
  cliente      cliente      @relation(fields: [cliente_id], references: [id], map: "fk_produto_servico_cliente")
  tipo_produto tipo_produto @relation(fields: [tipo_id], references: [id], map: "fk_produto_servico_tipo")
  venda_item   venda_item[]

  @@unique([cliente_id, id], map: "uq_produto_servico_cliente_id")
  @@index([cliente_id], map: "idx_produto_servico_cliente_id")
  @@index([tipo_id], map: "idx_produto_servico_tipo_id")
}

model tipo_produto {
  id              Int               @id @default(autoincrement())
  nome            String            @unique @db.VarChar(50)
  produto_servico produto_servico[]
}


model venda {
  id             Int          @id @default(autoincrement())
  cliente_id     Int
  funcionario_id String       @db.VarChar(100)
  datavenda      DateTime     @default(now()) @db.Timestamp(6)
  status         String       @default("ABERTA") @db.VarChar(10)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  cliente        cliente      @relation(fields: [cliente_id], references: [id], map: "fk_venda_cliente")
  funcionario    funcionario  @relation(fields: [cliente_id, funcionario_id], references: [cliente_id, id], map: "fk_venda_funcionario_cliente")
  venda_item     venda_item[]

  @@unique([cliente_id, id], map: "uq_venda_cliente_id")
  @@index([cliente_id], map: "idx_venda_cliente_id")
  @@index([datavenda], map: "idx_venda_data")
  @@index([funcionario_id], map: "idx_venda_funcionario_id")
  @@index([status], map: "idx_venda_status")
}


model venda_item {
  id                 Int             @id @default(autoincrement())
  cliente_id         Int
  venda_id           Int
  produto_servico_id Int
  quantidade         Decimal         @db.Decimal(12, 3)
  preco_unitario     Decimal         @db.Decimal(12, 2)
  subtotal           Decimal?        @default(dbgenerated("(quantidade * preco_unitario)")) @db.Decimal(14, 2)
  produto_servico    produto_servico @relation(fields: [cliente_id, produto_servico_id], references: [cliente_id, id], map: "fk_venda_item_produto_servico")
  venda              venda           @relation(fields: [cliente_id, venda_id], references: [cliente_id, id], onDelete: Cascade, map: "fk_venda_item_venda")

  @@index([cliente_id, produto_servico_id], map: "idx_venda_item_produto")
  @@index([cliente_id, venda_id], map: "idx_venda_item_venda_id")
}
