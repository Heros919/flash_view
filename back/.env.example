DB_NAME=banco
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
# Fora do Docker (npm run start:dev na sua máquina): porta 5433
DATABASE_URL="postgresql://postgres:troque-esta-senha@localhost:5433/banco?schema=public"
# JWT_SECRET e ADMIN_BOOTSTRAP_KEY precisam ter NO MÍNIMO 32 caracteres.
# Gere cada uma com: openssl rand -hex 32
JWT_SECRET=cole-aqui-o-resultado-do-openssl-rand-hex-32
ADMIN_BOOTSTRAP_KEY=cole-aqui-outro-resultado-do-openssl-rand-hex-32
# No Render: SEM aspas e SEM barra no final (ex.: https://flashview-front.onrender.com)
FRONT_URL=http://localhost:5500